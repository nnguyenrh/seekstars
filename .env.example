# StarSeek Configuration
# Copy this file to .env and fill in your values.

# ── Required ─────────────────────────────────────────────
# Register free at https://www.geonames.org/login
# Then enable web services at https://www.geonames.org/manageaccount
GEONAMES_USERNAME=

# ── Admin Account ────────────────────────────────────────
# Default admin password (change this!)
STARSEEK_ADMIN_PASSWORD=admin

# ── Optional (defaults shown) ───────────────────────────
# STARSEEK_HOST=0.0.0.0
# STARSEEK_PORT=8000
# STARSEEK_DB_PATH=./starseek.db
# STARSEEK_EPHE_PATH=           # Empty = use bundled ephemeris
# STARSEEK_DEFAULT_HOUSE_SYSTEM=Placidus
# STARSEEK_LOG_LEVEL=INFO
